# Copia este archivo a .env.local y rellena los valores en tu máquina. Nunca subas .env.local al repo.

# Supabase (proyecto compartido; tablas cuentos_*). La URL no es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://bcicjjkgjgajxbrwmeyf.supabase.co
# Service role: SOLO servidor (rutas API y worker). Nunca en el cliente ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Si existe, /api/lead también reenvía cada email a este webhook (Buttondown, Resend, Make, n8n…).
LEADS_WEBHOOK_URL=

# Edición ilustrada (worker del Mac Mini y scripts/fase0.mjs): dry-run | gemini-images | openai-images. dry-run = sin coste.
GENERATION_PROVIDER=dry-run
# Solo con GENERATION_PROVIDER=gemini-images. Solo servidor/worker; cada llamada cuesta dinero.
GEMINI_API_KEY=
# Opcional: modelo de imagen de Gemini (por defecto gemini-nano-banana-2.1, Nano Banana 2.1).
GEMINI_IMAGE_MODEL=
# Opcional: modalidades de respuesta de Gemini (IMAGE por defecto; TEXT,IMAGE si el modelo lo exige).
GEMINI_RESPONSE_MODALITIES=
# Solo con GENERATION_PROVIDER=openai-images. Cada llamada cuesta dinero.
OPENAI_API_KEY=
# Opcional: modelo, tamaño de página y calidad de OpenAI (por defecto gpt-image-1, 1536x1024, medium; la hoja va a 1024x1024).
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=
OPENAI_IMAGE_QUALITY=
# Tope de coste por libro en céntimos (worker).
MAX_COST_CENTS_PER_BOOK=300
# Estimación por imagen en céntimos; vacío = valor del proveedor (gemini 4, openai 8). Estimaciones hasta medir en la Fase 0.
GENERATION_COST_CENTS_PER_IMAGE=
# Presupuesto (tabla cuentos_spend): tope por lead antes del pago, en céntimos (por defecto 10).
LEAD_CAP_CENTS=
# Presupuesto: tope global por día UTC, en céntimos (por defecto 500), de lo que no se cobra: dibujos antes del pago,
# libros pagados con la tarjeta de prueba y el texto (escribir el cuento y cambiar páginas). Lo pintado para libros
# cobrados de verdad, tras el cobro, no cuenta. Al pasar del 80 % llega un aviso a MAIL_FORWARD_TO.
DAILY_CAP_CENTS=
# Opcional (fase0.mjs): tarifa en céntimos por millón de tokens de entrada para calcular el coste real desde `usage`.
IMAGE_PRICE_CENTS_PER_1M_INPUT_TOKENS=
# Opcional (fase0.mjs): tarifa en céntimos por millón de tokens de salida (imagen).
IMAGE_PRICE_CENTS_PER_1M_OUTPUT_TOKENS=
# Opcional: raíz del repo para resolver las anclas de estilo (por defecto se prueba el directorio actual y su padre).
CUENTOS_REPO_ROOT=

# Protege POST /api/jobs hasta que exista el flujo de pago. Genera un valor aleatorio largo en local.
JOBS_API_SECRET=

# Demo de la edición ilustrada sin Stripe: activa el paso «Pago simulado» y las ilustraciones de vista previa (dry-run, sin coste).
# Se lee en el build (NEXT_PUBLIC_*). Déjalo vacío en producción hasta tener el pago real.
NEXT_PUBLIC_DRY_RUN_PAYMENT=

# Medición con PostHog Cloud EU (opcional; es la única: Clarity se quitó el 21 oct). Identificador de proyecto (phc_…) de eu.posthog.com → Project settings. Se lee en el build y
# solo se carga tras «Aceptar» en el aviso de cookies (lib/analytics.ts). Nunca una clave personal (phx_…).
NEXT_PUBLIC_POSTHOG_KEY=

# Motor de historia (/api/story): mock | anthropic | openai. Sin valor: anthropic si hay ANTHROPIC_API_KEY; si no, mock (sin coste).
# Sin la clave del proveedor elegido también se usa mock. STORY_PROVIDER=mock fuerza el simulado aunque haya clave.
STORY_PROVIDER=
# Opcional: modelo del proveedor (por defecto claude-sonnet-4-5 con anthropic, gpt-4.1-mini con openai).
STORY_MODEL=
# Solo servidor. Cada llamada cuesta dinero.
ANTHROPIC_API_KEY=
# (OPENAI_API_KEY, arriba, sirve también para STORY_PROVIDER=openai)
# Opcional: céntimos por 1.000 tokens de entrada y de salida para estimar el coste de cada cuento.
STORY_COST_CENTS_PER_1K_IN=
STORY_COST_CENTS_PER_1K_OUT=
# Opcional: peticiones por hora y por IP a /api/story (20 por defecto; además 1 por segundo).
STORY_RATE_PER_HOUR=

# PDF en servidor. En Vercel, el Chromium de @sparticuz/chromium viaja dentro de la función (next.config.ts). Solo si la
# función no lo trae, se baja el paquete de esta URL (por defecto la release v153 de Sparticuz en GitHub).
# En local, ruta a un Chrome/Chromium; si falta, se usa el de Playwright.
# CHROMIUM_PACK_URL=
# CHROME_PATH=

# ---------------------------------------------------------------- B5: pago, emails y segundo plano
# Stripe Checkout (solo servidor). Hacen falta las dos para cobrar; si no, pago de prueba (fuera de producción) o «muy pronto».
# Webhook en Stripe → https://<dominio>/api/stripe/webhook, eventos checkout.session.completed y
# checkout.session.async_payment_succeeded. STRIPE_WEBHOOK_SECRET es el «Signing secret» (whsec_…) de ese endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: aperturas de checkout por hora y por IP (20 por defecto).
CHECKOUT_RATE_PER_HOUR=
# Resend (solo servidor): el enlace del libro al dar el email y «tu libro está listo» al terminar las 12 páginas.
# MAIL_FROM con un dominio verificado en Resend, p. ej. "Érase su vez <hola@erasesuvez.com>". Sin las dos no se manda nada.
RESEND_API_KEY=
MAIL_FROM=
# Correo entrante (lib/inbound.ts): Resend recibe lo que llega a @erasesuvez.com y avisa a /api/mail/inbound, que lo
# reenvía a MAIL_FORWARD_TO (una o varias direcciones separadas por comas, de otro dominio) con «Responder a» el
# remitente. RESEND_WEBHOOK_SECRET es el «Signing secret» (whsec_…) de ese webhook en Resend. La RESEND_API_KEY
# necesita acceso completo para leer los correos recibidos (una de solo envío da 401/403).
RESEND_WEBHOOK_SECRET=
MAIL_FORWARD_TO=
# Origen público de los enlaces de los emails y de la vuelta de Stripe (sin barra final). Sin valor, el de la petición.
SITE_URL=
# La app (/crear y las API que escriben, pintan o cobran): 1 abierta, 0 cerrada. Sin valor, abierta fuera de producción y
# cerrada en producción, donde la landing enseña «Muy pronto» (lib/appOpen.ts, proxy.ts). Tras cambiarla, volver a desplegar.
APP_OPEN=
# 0 = el servidor no pinta en segundo plano con after() (solo el navegador). Por defecto, sí.
BACKGROUND_PAINT=
# Cron diario de borrado a 30 días (/api/cron/purge, vercel.json). Vercel manda «Authorization: Bearer $CRON_SECRET».
# Obligatorio en cualquier despliegue de Vercel, también en Preview si se quieren lanzar a mano (sin él, los crons
# responden 503). En local no hace falta. Un valor aleatorio largo. Lo usa también /api/cron/print.
CRON_SECRET=
# /api/dev (pruebas de pago con Gemini y Claude): en las previews de Vercel solo responde con este valor en ?token= o en la
# cabecera x-dev-token. Sin valor, 404 en todas las previews. En local no hace falta; en producción no existe nunca.
DEV_TOKEN=

# ---------------------------------------------------------------- B8: libro impreso (Gelato)
# Clave de la API de Gelato (dashboard.gelato.com → API keys). Sin ella no hay imprenta: fuera de producción se simula con
# NEXT_PUBLIC_DRY_RUN_PAYMENT=1 y en producción la tapa dura no se ofrece.
GELATO_API_KEY=
# Opcional: productUid del fotolibro de tapa dura 20×20. Sin valor se busca en el catálogo (tapa dura, 200x200 mm u 8x8").
GELATO_PRODUCT_UID=
# Webhook de Gelato → https://<dominio>/api/print/webhook?token=<este valor>. Un valor aleatorio largo. Sin él, 501.
GELATO_WEBHOOK_SECRET=
# Fuera de producción los pedidos se crean como borrador (Gelato no los imprime). «order» para imprimir de verdad desde la
# preview (la muestra). En producción siempre son pedidos.
GELATO_ORDER_TYPE=
# Opcional: pageCount del pedido (por defecto 30, las páginas interiores; Gelato suma las tapas). Cambiarlo solo si la muestra lo pide.
GELATO_PAGE_COUNT=

# ---------------------------------------------------------------- Legales (aviso legal, condiciones, privacidad)
# Datos del titular (art. 10 LSSI). En Vercel y no en el código: el repo es público. Las páginas legales son estáticas,
# así que tras cambiarlos hay que volver a desplegar. Sin nombre, NIF ni domicilio, sale el nombre comercial «Érase su
# vez» (decisión de Álvaro, 20 oct): solo LEGAL_EMAIL hace falta.
LEGAL_NAME=
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_EMAIL=
