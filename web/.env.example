# Copia este archivo a .env.local y rellena los valores en tu máquina. Nunca subas .env.local al repo.

# Supabase (proyecto compartido; tablas cuentos_*). La URL no es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://bcicjjkgjgajxbrwmeyf.supabase.co
# Service role: SOLO servidor (rutas API y worker). Nunca en el cliente ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Si existe, /api/lead también reenvía cada email a este webhook (Buttondown, Resend, Make, n8n…).
LEADS_WEBHOOK_URL=

# Edición ilustrada (worker del Mac Mini). dry-run = sin coste.
GENERATION_PROVIDER=dry-run
# Solo con GENERATION_PROVIDER=openai-images. Cada llamada cuesta dinero.
OPENAI_API_KEY=
# Tope de coste por libro en céntimos y estimación por imagen (medir el real en la Fase 0).
MAX_COST_CENTS_PER_BOOK=300
GENERATION_COST_CENTS_PER_IMAGE=7

# Protege POST /api/jobs hasta que exista el flujo de pago. Genera un valor aleatorio largo en local.
JOBS_API_SECRET=
